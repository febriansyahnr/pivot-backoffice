{
  "openapi": "3.0.3",
  "info": {
    "title": "Merchant RCN Balance Inquiry API",
    "description": "API for retrieving Real Card Number (RCN) balance details for corporate cards.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/internal/v1/merchants/rcns/{rcn_id}": {
      "get": {
        "summary": "Retrieve Merchant RCN Balance Detail",
        "description": "Fetches balance details of a merchant's corporate card.",
        "operationId": "getMerchantRcnBalance",
        "parameters": [
          {
            "name": "rcn_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Merchant ID",
            "in": "header",
            "name": "X-MERCHANT-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
