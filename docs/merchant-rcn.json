                              "type": "object",
                              "properties": {
                                "accountName": {
                                  "type": "string",
                                  "example": "DI** **M"
                                },
                                "globalLimit": {
                                  "type": "object",
                                  "properties": {
                                    "value": {
                                      "type": "string",
                                      "example": "99999999999.99"
                                    },
                                    "currency": {
                                      "type": "string",
                                      "example": "IDR"
                                    }
                                  }
                                },
                                "globalLimitCash": {
                                  "type": "object",
