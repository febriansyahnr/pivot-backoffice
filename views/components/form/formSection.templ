package form

templ FormSection(title, subtitle string) {
	<div class="pb-12">
		if title != "" {
			<h2 class="text-base/7 font-semibold text-white">{ title }</h2>
		}
        if subtitle != "" {
            <p class="mt-1 text-sm/6 text-gray-400">{ subtitle }</p>
        }
		<div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        { children... }
		</div>
	</div>
}
