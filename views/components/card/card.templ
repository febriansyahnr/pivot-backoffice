package card

templ Card(id, title string) {
	<div
		id={id}
		class="divide-y divide-white/10 overflow-hidden rounded-lg bg-gray-800/50 outline -outline-offset-1 outline-white/10"
	>
		if title != "" {
			<div class="px-4 py-5 sm:px-6">
				<h3 class="text-base font-semibold text-white">{title}</h3>
			</div>
		}
		{ children... }
	</div>
}